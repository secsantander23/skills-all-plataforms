# Normalize line endings in the repository to LF.
# Markdown and code examples should not vary by contributor platform.
* text=auto eol=lf

*.md text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.sh text eol=lf
*.go text eol=lf
*.rs text eol=lf
*.java text eol=lf
*.cs text eol=lf
*.swift text eol=lf
*.kt text eol=lf
*.dart text eol=lf

